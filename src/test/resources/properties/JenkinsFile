pipeline {
    agent any  // Run on any available agent

    tools {
        maven 'Maven'    // Maven tool configured in Jenkins
        jdk 'JDK11'      // JDK version configured in Jenkins
    }

    environment {
        DRIVER_PATH = "/path/to/chromedriver" // Path to browser driver if needed
    }

    stages {
        stage('Checkout Code') {
            steps {
                echo 'Checking out code...'
                git branch: 'Radhika_new-Branch', url: 'https://github.com/raghavselenium2505/SeleniumHybridFramework.git'
            }
        }

        stage('Setup Environment') {
            steps {
                echo 'Setting up browser driver...'
                sh 'echo Setting up chromedriver'
                // Add browser driver setup if needed
            }
        }

        stage('Build and Test') {
            steps {
                echo 'Building project and running tests...'
                sh 'mvn clean test'
            }
        }

        stage('Publish Test Results') {
            steps {
                echo 'Publishing test results...'
                junit '**/target/surefire-reports/*.xml' // Publish JUnit XML results
            }
        }

        stage('Publish HTML Reports') {
            steps {
                echo 'Publishing Selenium HTML reports...'
                publishHTML(target: [
                    reportDir: 'resources/Reports/Extentreport',
                    reportFiles: 'index.html',
                    reportName: 'ExtentReport'
                ])
            }
        }
    }

    post {
        always {
            echo 'Archiving artifacts...'
            archiveArtifacts artifacts: '**/target/*.jar', fingerprint: true
            echo 'Pipeline completed!'
        }
    }
}
