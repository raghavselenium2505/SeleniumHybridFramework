<suite name="ParallelCrossBrowserSuite"
       parallel="classes"
       thread-count="3">

    <!-- 🔥 Listener added -->
   <listeners>
    <listener class-name="com.seleapi.listeners.TestListener"/>
</listeners>

    <test name="Monthly user Signup">

        <parameter name="testDataPath" value="src/test/resources/excel/MilkManData.json"/>
        <parameter name="browser" value="chrome"/>
        <parameter name="url" value="https://staging-uk.modernmilkman.dev/"/>

        <groups>
            <run>
                <include name="MilkManSignupTests"/>
            </run>
        </groups>

        <classes>
            <class name="com.seleapi.tests.MilkManLoginWithMontlyTest"/>
            <class name="com.seleapi.tests.MilkManSignupAnnuallyTest"/>
            <class name="com.seleapi.tests.MilkManLoginWithWeeklyTest"/>
        </classes>

    </test>

</suite>