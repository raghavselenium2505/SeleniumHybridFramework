<suite name="ParallelCrossBrowserSuite"
       parallel="tests"
       thread-count="2">

    <!-- ================= CHROME ================= -->
    <test name="ChromeTest">

        <parameter name="browser" value="chrome"/>
        <parameter name="url" value="https://www.naukri.com/"/>

        <groups>
            <run>
                <include name="json"/>
            </run>
        </groups>

        <classes>
            <class name="com.gps.development.Naukri_Login"/>
        </classes>

    </test>

    <!-- ================= EDGE ================= -->
    <test name="EdgeTest">

        <parameter name="browser" value="edge"/>
        <parameter name="url" value="https://www.naukri.com/"/>

        <groups>
            <run>
                <include name="json"/>
            </run>
        </groups>

        <classes>
            <class name="com.gps.development.Naukri_Login"/>
        </classes>

    </test>

</suite>