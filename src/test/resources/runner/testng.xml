<suite name="ParallelCrossBrowserSuite"
       parallel="tests"
       thread-count="2">

    <!-- ================= CHROME ================= -->
    <test name="MOnthly user Signup">

        <parameter name="browser" value="chrome"/>
        <parameter name="url" value="https://staging-uk.modernmilkman.dev/"/>

        <groups>
            <run>
                <include name="MilkManSignupTests"/>
            </run>
        </groups>

        <classes>
            <class name="com.gps.development.MilkManLoginWithMontlyTest"/>
            <class name="com.gps.development.MilkManSignupAnnuallyTest"/>
             <class name="com.gps.development.MilkManLoginWithWeeklyTest"/>

        </classes>

    </test>

  
  
</suite>