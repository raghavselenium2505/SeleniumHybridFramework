pipeline {
    agent any

    tools {
        maven 'MAVEN_HOME'
        jdk 'JAVA_HOME'
    }

    stages {
        stage('Clean Workspace') {
            steps {
                echo 'Cleaning workspace...'
                deleteDir() // This will clean the current workspace
            }
        }

        stage('Checkout Code') {
            steps {
                echo 'Checking out code from Git repository...'
                git branch: 'radhika_new-Branch', url: 'https://github.com/raghavselenium2505/SeleniumHybridFramework.git'
            }
        }

        stage('Build Project') {
            steps {
                echo 'Building Maven project...'
                sh 'mvn clean compile'
            }
        }

        stage('Run Tests') {
            steps {
                echo 'Running Selenium tests...'
                sh 'mvn test'
            }
        }
    }
}
