pipeline {
   agent any
   
   tools {
      maven 'MAVEN_HOME'
      jdk 'JAVA_HOME'
   }
   
   stages {
      stage('Clean Workspace') {
         steps {
            echo 'Cleaning workspace...'
            deleteDir()
         }
      }
      
      stage('Checkout Code') {
         steps {
            echo 'Checking out code...'
            git branch: 'Radhika_new-Branch', url: 'https://github.com/raghavselenium2505/SeleniumHybridFramework.git'
         }
      }
      stage('Build and Test') {
         steps {
            echo 'Building and testing the project...'
            bat 'mvn clean compile'
            bat 'mvn test'
         }
      }
        stage('Publish Latest Extent Report') {
            steps {
                echo 'Finding the latest Extent Report...'
                script {
                    // Find the latest file in the Reports directory
                    def reportFile = bat(script: 'for /f "delims=" %i in (\'dir /b /o-d src\\test\\resources\\Reports\\Extentreport\\extentreport_*.html\') do @echo %i', returnStdout: true).trim()
                    echo "Latest report file: ${reportFile}"
                    
                    // Publish the report
                    publishHTML(target: [
                        reportDir: 'src/test/resources/Reports/Extentreport',
                        reportFiles: reportFile,
                        reportName: 'Extent Report'
                    ])
                }
            }
        }
    }

    post {
        always {
            echo 'Archiving all Extent Reports...'
            archiveArtifacts artifacts: 'src/test/resources/Reports/Extentreport/*.html', fingerprint: true
        }
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check logs for more details.'
        }
    }
}