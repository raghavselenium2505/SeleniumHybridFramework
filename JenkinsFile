pipeline {
   agent any
   
   tools {
      maven 'MAVEN_HOME'
      jdk 'JAVA_HOME'
   }
   
   stages {
      stage('Clean Workspace') {
         steps {
            echo 'Cleaning workspace...'
            deleteDir()
         }
      }
      
      stage('Checkout Code') {
         steps {
            echo 'Checking out code...'
            git branch: 'Master', url: 'https://github.com/raghavselenium2505/SeleniumHybridFramework.git'
         }
      }
      stage('Build and Test') {
         steps {
            echo 'Building and testing the project...'
            bat 'mvn clean compile'
            bat 'mvn test'
         }
      }
   }
   post {
      always {
         echo 'Pipeline completed!'
      }
      failure {
         echo 'Pipeline failed. Please check the logs.'
      }
   }
}